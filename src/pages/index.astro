---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortfolioContent } from '../data/content';
import { ArrowRight, ExternalLink, Mail } from '@lucide/astro';

const { site, projects, skills, experience, featuredCertifications } = await getPortfolioContent();
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow availability"><span class="availability-dot"></span> Open to internships &amp; entry-level roles</div>
        <h1>{site.name}</h1>
        <h2>Building practical solutions through AI, data, and software.</h2>
        <p class="hero-description">
          An Informatics graduate with hands-on experience in machine learning, data processing, AI-powered applications, and system integration. Interested in turning technical knowledge into practical solutions for real-world problems.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects">View Projects <ArrowRight size={16} /></a>
          <a class="button" href={site.github} target="_blank" rel="noopener noreferrer"><ExternalLink size={16} /> GitHub</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/assets/personal/Foto.jpg" alt="Galang Rakha Ahnanta" width="800" height="1000" />
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <div class="section-heading">
        <div><div class="eyebrow">Selected work</div><h2>Featured projects</h2></div>
        <a class="text-link" href="/projects">Project archive <ArrowRight size={14} /></a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={`/projects/${project.slug}`}>
            {project.image && <div class="project-image"><img src={project.image} alt={project.alt} width="1200" height="750" loading="lazy" /></div>}
            <div class="project-card-body">
              <div class="eyebrow">{project.type}</div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <div class="tag-row">{project.tags.slice(0, 5).map((tag) => <span class="tag">{tag}</span>)}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <div class="about-grid">
        <div><div class="eyebrow">About</div></div>
        <div class="about-copy">
          <p>I am an Informatics graduate from Universitas Pembangunan Nasional “Veteran” Yogyakarta, with practical interests in AI, machine learning, data, software development, and system integration.</p>
          <p>My experience includes building a document-grounded RAG assistant and contributing to HOPTIMA, a Bangkit Academy capstone project. That work has developed my interest in connecting models and data with usable applications, while collaborating across technical disciplines.</p>
          <p>I am open to internship and entry-level opportunities where I can contribute to practical technical problems and continue developing as an engineer.</p>
        </div>
      </div>
      <div class="skills-grid" style="margin-top: 44px;">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.title}</h3>
            <div class="skill-list">{group.items.map((item) => <span>{item}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <div class="section-heading"><div><div class="eyebrow">Background</div><h2>Experience &amp; education</h2></div></div>
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item">
            <div class="eyebrow">{item.period}</div>
            <div><h3>{item.organization}</h3><div class="role">{item.role}</div><p>{item.detail}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="certifications">
    <div class="container">
      <div class="section-heading">
        <div><div class="eyebrow">Credentials</div><h2>Selected certifications</h2></div>
        <a class="text-link" href="/certifications">View all <ArrowRight size={14} /></a>
      </div>
      <div class="cert-list">
        {featuredCertifications.map(({ title, issuer }) => (
          <div class="cert-item"><strong>{title}</strong><span>{issuer}</span><ArrowRight size={16} /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="container">
      <div class="eyebrow">Contact</div>
      <h2>Let’s connect.</h2>
      <p>Available for internships, entry-level opportunities, and relevant professional collaboration.</p>
      <div class="contact-links">
        <a class="button button-primary" href={`mailto:${site.email}`}><Mail size={16} /> Email</a>
        <a class="button" href={site.linkedin} target="_blank" rel="noopener noreferrer"><ExternalLink size={16} /> LinkedIn</a>
        <a class="button" href={site.github} target="_blank" rel="noopener noreferrer"><ExternalLink size={16} /> GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
